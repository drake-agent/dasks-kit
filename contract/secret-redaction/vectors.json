{
  "version": 1,
  "about": "Shared secret-redaction cases. A positive case joins secret_parts into the value, puts it at {S} in template, and its redacted output must not contain the value and must contain every keep string. A negative case (secret_parts null) must come out equal to its template. Values are stored in parts and PEM labels use \\u0020 so that no secret scanner reads a whole credential in this file. gitleaks decodes \\u escapes, so the PEM cases also carry its inline marker gitleaks:allow (the key body is never in the file). {AT} in a template stands for @, so a credential URL is whole only at run time.",
  "cases": [
    {"id": "json-password", "template": "{\"password\": \"{S}\", \"user\": \"bob\"}", "secret_parts": ["fk", "zq1", "wv"], "keep": ["\"user\": \"bob\""]},
    {"id": "json-password-spaced", "template": "{ \"password\" :   \"{S}\" , \"n\": 1 }", "secret_parts": ["fk", "zq2", "wv"], "keep": ["\"password\"", "\"n\": 1"]},
    {"id": "authorization-bearer", "template": "Authorization: Bearer {S}", "secret_parts": ["abCd12", "efgh", "ij"], "keep": ["Authorization:"]},
    {"id": "basic-scheme", "template": "curl -H 'X: Basic {S}' https://h/x", "secret_parts": ["dXNlcj", "pwYXNz"], "keep": ["curl -H"]},
    {"id": "url-credential", "template": "git clone https://bob:{S}{AT}github.com/x/y.git", "secret_parts": ["fk", "zq3", "wv"], "keep": ["git clone https://", "@github.com/x/y.git"]},
    {"id": "url-credential-nested", "template": "fetch http://proxy.local/?to=https://bob:{S}{AT}h2.local/x done", "secret_parts": ["fk", "zq4", "wv"], "keep": ["http://proxy.local/?to=https://", "@h2.local/x done"]},
    {"id": "url-credential-percent-encoded", "template": "next=https%3A%2F%2Fu%3A{S}%40h2%2F&page=2", "secret_parts": ["fk", "zq5", "wv"], "keep": ["next=https%3A%2F%2F", "%40h2%2F&page=2"]},
    {"id": "url-credential-empty-user", "template": "cache at redis://:{S}{AT}cache.local:6379/0 up", "secret_parts": ["fk", "zq9", "wv"], "keep": ["cache at redis://", "@cache.local:6379/0 up"]},
    {"id": "url-credential-percent-encoded-empty-user", "template": "next=redis%3A%2F%2F%3A{S}%40cache.local%2F0", "secret_parts": ["fk", "zq10", "wv"], "keep": ["next=redis%3A%2F%2F", "%40cache.local%2F0"]},
    {"id": "url-query-access-token", "template": "GET https://api.x.local/v1?access_token={S}", "secret_parts": ["fk", "zq6", "wv"], "keep": ["GET https://api.x.local/v1?"]},
    {"id": "cwd-with-url-credential", "template": "cwd: /Users/x/repo (origin https://bob:{S}{AT}github.com/x/y)", "secret_parts": ["fk", "zq7", "wv"], "keep": ["cwd: /Users/x/repo", "@github.com/x/y)"]},
    {"id": "pem-rsa-whole", "scan": "gitleaks:allow", "template": "-----BEGIN RSA PRIVATE\u0020KEY-----\n{S}\n-----END RSA PRIVATE\u0020KEY-----\nafter the key", "secret_parts": ["MIIEowIBAAK", "\n", "CAQEAx1y2z"], "keep": ["after the key"]},
    {"id": "pem-openssh-whole", "scan": "gitleaks:allow", "template": "key:\n-----BEGIN OPENSSH PRIVATE\u0020KEY-----\n{S}\n-----END OPENSSH PRIVATE\u0020KEY-----\nafter the key", "secret_parts": ["b3BlbnNzaC1r", "\n", "ZXktdjEAAAAA"], "keep": ["key:", "after the key"]},
    {"id": "pem-unterminated", "scan": "gitleaks:allow", "template": "log start\n-----BEGIN EC PRIVATE\u0020KEY-----\n{S}", "secret_parts": ["MHcCAQEEI", "\n", "Bk2x9yz"], "keep": ["log start"]},
    {"id": "pem-pgp-block", "scan": "gitleaks:allow", "template": "-----BEGIN PGP PRIVATE\u0020KEY BLOCK-----\n\n{S}\n-----END PGP PRIVATE\u0020KEY BLOCK-----\nafter the key", "secret_parts": ["lQOYBGF", "\n", "xk2wBCAC"], "keep": ["after the key"]},
    {"id": "pem-label-with-digit", "scan": "gitleaks:allow", "template": "-----BEGIN PKCS8 PRIVATE\u0020KEY-----\n{S}\n-----END PKCS8 PRIVATE\u0020KEY-----\nafter the key", "secret_parts": ["MIIEvQIBAD", "\n", "ANBgkqhki"], "keep": ["after the key"]},
    {"id": "xai-key", "template": "api call with {S} failed", "secret_parts": ["xa", "i-", "abc123", "def456", "ghi789"], "keep": ["api call with ", " failed"]},
    {"id": "stripe-key", "template": "charge with {S} failed", "secret_parts": ["sk", "_live_", "abcdefgh", "ijklmnop", "qrst"], "keep": ["charge with ", " failed"]},
    {"id": "gitlab-token", "template": "clone with {S} failed", "secret_parts": ["gl", "pat-", "abcdefghij", "klmnopqrst", "uv"], "keep": ["clone with ", " failed"]},
    {"id": "npm-token", "template": "publish with {S} failed", "secret_parts": ["np", "m_", "abcdefghijkl", "mnopqrstuvwx", "yz0123456789"], "keep": ["publish with ", " failed"]},
    {"id": "huggingface-token", "template": "download with {S} failed", "secret_parts": ["h", "f_", "abcdefghijkl", "mnopqrstuvwx", "yzabcd"], "keep": ["download with ", " failed"]},
    {"id": "groq-key", "template": "call with {S} failed", "secret_parts": ["gs", "k_", "abcdefghijklmnop", "qrstuvwxyzabcdef", "ghijklmn"], "keep": ["call with ", " failed"]},
    {"id": "sk-ant-key", "template": "claude call with {S} failed", "secret_parts": ["sk", "-ant-", "api03-", "abcdefgh", "12345678", "ijkl"], "keep": ["claude call with ", " failed"]},
    {"id": "github-token", "template": "remote said {S} is bad", "secret_parts": ["gh", "p_", "abcdefghij", "0123456789", "klmnopqrst", "uv"], "keep": ["remote said ", " is bad"]},
    {"id": "slack-token", "template": "slack {S} posted", "secret_parts": ["xo", "xb-", "1234567890", "-abcdefghij"], "keep": ["slack ", " posted"]},
    {"id": "aws-key", "template": "aws {S} denied", "secret_parts": ["AK", "IA", "ABCDEFGH", "IJKLMNOP"], "keep": ["aws ", " denied"]},
    {"id": "jwt", "template": "cookie value {S} expired", "secret_parts": ["ey", "JhbGciOiJI", "UzI1NiJ9", ".", "eyJzdWIiOiIx", "MjM0NTY3", ".", "abcdefghijk"], "keep": ["cookie value ", " expired"]},
    {"id": "kv-env-style", "template": "export DB_PASSWORD={S}\nexport DB_HOST=db.local", "secret_parts": ["fk", "zq8", "wv"], "keep": ["export DB_PASSWORD=", "export DB_HOST=db.local"]},
    {"id": "prose-basic-flow", "template": "This is the basic flow of the app.", "secret_parts": null, "keep": []},
    {"id": "prose-bearer-of-news", "template": "I am the bearer of news today.", "secret_parts": null, "keep": []},
    {"id": "prose-token-budget", "template": "The token budget is 4000 per call.", "secret_parts": null, "keep": []},
    {"id": "key-author", "template": "author: Jane Park", "secret_parts": null, "keep": []},
    {"id": "key-max-tokens", "template": "max_tokens: 4096", "secret_parts": null, "keep": []},
    {"id": "prose-pass-1-clean", "template": "Pass 1: clean, no findings.", "secret_parts": null, "keep": []}
  ]
}
