{
  "name": "dasks",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Dasks: goal-first work board for one person and their coding agents, over plain files (git repo = database)",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node scripts/test-wall.ts node --test --test-timeout=900000 --test-force-exit --import=./test/file-limit-preload.ts test/*.test.ts",
    "check": "bin/dasks-check",
    "start": "bin/dasks-server",
    "typecheck": "tsc -p . && tsc -p test",
    "verify": "npm run typecheck && npm test"
  },
  "dependencies": {
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "~5.9.3"
  }
}
